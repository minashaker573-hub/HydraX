{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix backend",
  "buildCommand": "node scripts/vercel-build.mjs",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/dist/db/schema.sql",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api?__hydrax_path=/api/$1" },
    { "source": "/health", "destination": "/api?__hydrax_path=/health" },
    { "source": "/health/(.*)", "destination": "/api?__hydrax_path=/health/$1" },
    { "source": "/assets/uploads/(.*)", "destination": "/api?__hydrax_path=/assets/uploads/$1" },
    { "source": "/dashboard/(.*)", "destination": "/dashboard/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/maintenance", "schedule": "0 3 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self' data:; base-uri 'none'; form-action 'self'; frame-ancestors 'self'; object-src 'none'"
        }
      ]
    }
  ]
}
