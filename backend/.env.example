# HYDRAX backend — environment template.
#
# Copy to `.env` and fill in real values. `.env` is git-ignored and MUST NOT be
# committed. `npm start`/`npm test`/`npm run dev` load it automatically via
# Node's native `--env-file-if-exists` flag (no-op if the file is absent, so
# CI/host-provided env vars still work) — there is still no dotenv dependency,
# and the application code itself reads process.env directly either way. See
# docs/CONFIGURATION.md.
#
#   cp backend/.env.example backend/.env

# --- secrets (required) ------------------------------------------------------

# Shared secret controllers present in X-Device-Key. Must match kDeviceKey in
# firmware/src/config/secrets.h.
HYDRAX_DEVICE_KEY=change-me-device

# Operator secret for actions that change server-side state: editing zone
# thresholds, resolving alerts, and reading customer quote requests.
# MUST be different from HYDRAX_DEVICE_KEY — the device key is flashed into
# every controller in the field, the operator key is not.
HYDRAX_ADMIN_KEY=change-me-admin

# Set to "true" ONLY for local development. Runs with both keys disabled and
# every endpoint open. The server logs a warning on every start.
# HYDRAX_ALLOW_INSECURE=false

# --- network -----------------------------------------------------------------

HYDRAX_HOST=0.0.0.0
HYDRAX_PORT=8080

# --- storage -----------------------------------------------------------------

# Postgres connection string — Supabase's "Session pooler" URI (not "Direct
# connection", which is IPv6-only, and not "Transaction pooler", which does
# not reliably support the per-connection SET this backend's schema isolation
# depends on). From the Supabase dashboard: Project Settings -> Database ->
# Connection string -> URI tab -> Session pooler. Percent-encode any special
# characters in the password (e.g. @ becomes %40).
HYDRAX_DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:change-me@aws-0-REGION.pooler.supabase.com:5432/postgres

# Telemetry older than this is pruned every 6 hours. 0 disables pruning.
# A device's most recent sample is never pruned, so a device that has gone
# quiet keeps its last known state.
HYDRAX_RETENTION_DAYS=30

# --- monitoring behaviour ----------------------------------------------------

# A device silent for longer than this is reported offline and raises a
# DEVICE_OFFLINE alert. Should comfortably exceed the firmware's telemetry
# interval (15 s by default).
HYDRAX_OFFLINE_TIMEOUT_MS=60000
HYDRAX_OFFLINE_SWEEP_MS=15000

# --- misc --------------------------------------------------------------------

# ERROR | WARN | INFO | DEBUG
HYDRAX_LOG_LEVEL=INFO

# Directory served as the dashboard. Defaults to ../dashboard.
# HYDRAX_DASHBOARD_DIR=../dashboard

# Directory served as the public website. Defaults to ../website.
# HYDRAX_WEBSITE_DIR=../website

# Directory served as the operator console. Defaults to ../admin.
# HYDRAX_ADMIN_DIR=../admin

# --- public quote form -------------------------------------------------------

# POST /api/v1/requests is the only unauthenticated write endpoint. These cap
# how many submissions one source may make per window. In-memory and keyed on
# a client-controlled header: a speed bump against retry storms and casual
# abuse, not a defence against a distributed flood - that belongs at the proxy.
HYDRAX_REQUEST_RATE_MAX=10
HYDRAX_REQUEST_RATE_WINDOW_MS=3600000

# --- cross-origin website (optional) -----------------------------------------

# Set this ONLY if the public website is deployed separately from this
# backend (e.g. website on Vercel, backend on Render) — see
# docs/DEPLOYMENT.md. Unset (the default) means same-origin only, and no
# CORS headers are ever sent. Exactly one origin, never a wildcard: this
# unlocks the browser CORS grant for the one public unauthenticated endpoint,
# POST /api/v1/requests, only.
# HYDRAX_ALLOWED_ORIGIN=https://your-site.vercel.app

# --- tests ---------------------------------------------------------------

# Only read by the test suite (test/helpers.ts), never by the server. Points
# tests at a Postgres database to create and drop schemas in — point this at
# a throwaway/dev Supabase project, not production. Falls back to
# HYDRAX_DATABASE_URL above if unset.
# HYDRAX_TEST_DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:change-me@aws-0-REGION.pooler.supabase.com:5432/postgres
