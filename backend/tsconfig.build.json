{
  // Emits backend/src as runnable JavaScript in backend/dist, for the Vercel
  // Function (api/index.js). Local `npm start` and the tests never use this:
  // they run the TypeScript sources directly with Node's type stripping.
  //
  // rewriteRelativeImportExtensions turns `import './app.ts'` into
  // `import './app.js'` on emit, so the compiled output resolves on its own.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": false,
    "declaration": false
  },
  "include": ["src/**/*.ts"]
}
